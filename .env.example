# No credentials are required to build or preview the public/account screens.
# Before account/link features are enabled, configure a trusted canonical origin.
APP_ORIGIN=http://localhost:3000

# Used by npm run db:check; keep actual values in ignored .env.local or .env.
# MONGODB_URI=mongodb+srv://...
# MONGODB_DB_NAME=make_my_marriage_dev

# Account services require MongoDB, the trusted APP_ORIGIN, and these keys.
# Generate each key separately with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# RATE_LIMIT_HMAC_KEY=
# ACCOUNT_EMAIL_ENCRYPTION_KEY=
# CRON_SECRET=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Make My Marriage <accounts@your-verified-domain.example>
# RESEND_WEBHOOK_SECRET=

# Future integrations; validate configuration when implemented.
# CAPABILITY_ENCRYPTION_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_WEBHOOK_SECRET=
# ABLY_API_KEY=
# GOOGLE_PLACES_API_KEY=

