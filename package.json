{
  "name": "make-my-marriage",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "db:check": "node --conditions=react-server --import tsx scripts/check-database.mjs",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate-accounts.ts",
    "email:process": "node --conditions=react-server --import tsx scripts/send-account-mail.ts",
    "test:auth": "node --conditions=react-server --import tsx --test tests/auth.test.ts",
    "test:env": "node --import tsx --test tests/load-env.test.ts",
    "test:countdown": "node --import tsx --test tests/countdown.test.ts",
    "test:weddings": "node --conditions=react-server --import tsx --test tests/weddings.test.ts",
    "test:invitations": "node --conditions=react-server --import tsx --test tests/invitations.test.ts",
    "test:members": "node --conditions=react-server --import tsx --test tests/members.test.ts",
    "test:tasks": "node --conditions=react-server --import tsx --test tests/tasks.test.ts tests/task-form.test.mjs",
    "test:guests": "node --conditions=react-server --import tsx --test tests/households.test.ts tests/guest-form.test.mjs",
    "test:events": "node --conditions=react-server --import tsx --test tests/events.test.ts tests/event-form.test.mjs tests/schedule-event.test.mjs",
    "test:rsvp": "node --conditions=react-server --import tsx --test tests/guest-access.test.ts tests/rsvp-form.test.mjs",
    "media:check": "node --conditions=react-server --import tsx scripts/check-media.ts",
    "test:media": "node --conditions=react-server --import tsx --test tests/media-provider.test.ts tests/media.test.ts",
    "test:gallery-ui": "node --import tsx --test tests/gallery-ui.test.tsx tests/gallery-upload.test.mjs",
    "media:process": "node --conditions=react-server --import tsx scripts/process-media.ts",
    "test:gallery-access": "node --conditions=react-server --import tsx --test tests/gallery-access.test.ts",
    "test:gallery-sharing-ui": "node --import tsx --test tests/gallery-sharing.test.mjs",
    "test:guest-uploads": "node --conditions=react-server --import tsx --test tests/guest-uploads.test.ts tests/guest-upload-panel.test.mjs",
    "test:expenses": "node --conditions=react-server --import tsx --test tests/expenses.test.ts tests/expense-form.test.mjs",
    "test:loading": "node --import tsx --test tests/page-loading.test.mjs"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "mongodb": "7.7.0",
    "next": "16.4.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "svix": "2.8.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.2"
  }
}
